# Required. One key covers Claude and web search.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
# PODCAST_AGENT_MODEL=claude-opus-5-5
# PODCAST_AGENT_EFFORT=medium            # low | medium | high | xhigh | max
# PODCAST_AGENT_MAX_STEPS=25
# PODCAST_AGENT_CONCURRENCY=3
# PODCAST_AGENT_CLIENT=default           # id under data/clients/, or a path to a policy JSON
# PODCAST_AGENT_WEB_SEARCH=true          # false = offline mode (pinned facts + local KB only)
# PODCAST_AGENT_WEB_SEARCH_MAX_USES=8    # web searches per model turn
# PODCAST_AGENT_REFUSAL_FALLBACK=true
# PODCAST_AGENT_OTEL=false               # true = OpenTelemetry traces + metrics (pip install ".[otel]")
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=podcast-agent
# PODCAST_AGENT_KB=data/knowledge_base.json
# PODCAST_AGENT_OUTPUT=output
# PODCAST_AGENT_DB=var/podcast_agent.db     # results store (SQLite) shared by the GUI and the worker
